# Copy to .env and fill in. You can also paste keys in the studio (Settings tab); keys saved there
# are kept in data/settings.json and take priority over this file.
# With no key at all the studio runs in mock mode (placeholder images, silent voice), for free.

# OpenAI: scripts, reel analysis, images, voiceover, transcription.
OPENAI_API_KEY=
# Models (defaults shown). Any chat model that supports Structured Outputs works for text.
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high (gpt-image-1 only). Higher costs more.
OPENAI_IMAGE_QUALITY=medium
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Watch & remake: analysis reads key frames with a vision model and transcribes speech.
# OPENAI_VISION_MODEL defaults to OPENAI_TEXT_MODEL. whisper-1 gives word timings.
OPENAI_VISION_MODEL=
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Reel links are downloaded with yt-dlp (install it: pip install yt-dlp). Instagram often needs a
# login: name a browser you are logged in with (chrome, firefox, safari, edge) or a cookies.txt file.
YTDLP_PATH=yt-dlp
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES=
# Caption languages to take from the site when there is no OpenAI key (yt-dlp syntax).
WATCH_SUB_LANGS=en.*
WATCH_MAX_SECONDS=600
WATCH_MAX_FRAMES=40
# Lower finds more cuts (0.1-0.5).
WATCH_SCENE_THRESHOLD=0.3
WATCH_UPLOAD_LIMIT_MB=300

# Claude (Anthropic): scripts, remakes, patterns and reel analysis. Claude does not make images or
# voice; with only a Claude key, reels use text-card backgrounds with captions and no voiceover.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (best), claude-sonnet-5-5 (balanced), claude-haiku-4-5-20251001 (fastest, cheapest)
ANTHROPIC_MODEL=claude-opus-5-5
# Who does which job when both keys are set: auto | openai | anthropic (auto = OpenAI).
AI_TEXT_PROVIDER=auto
AI_VISION_PROVIDER=auto

# Instagram auto-posting (optional). All three are needed; see README.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Public https address where Instagram can download the videos, e.g. a tunnel or your server.
PUBLIC_BASE_URL=
GRAPH_API_VERSION=v21.0

# Server. HOST=127.0.0.1 keeps the studio on this computer; use 0.0.0.0 to open it to your network.
PORT=3000
HOST=127.0.0.1
# Password for the studio (any user name). Set it whenever the studio is reachable from outside this
# computer (HOST=0.0.0.0, a tunnel, a server). Without it, Settings can only be changed locally.
STUDIO_PASSWORD=
DATA_DIR=data
# Caption highlight colour
ACCENT_COLOR=#C8F53A
# Force mock mode even with a key: MOCK=1
